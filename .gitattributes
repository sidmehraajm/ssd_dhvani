# Store text with LF in the repo; each OS checks out its own line endings.
* text=auto
# Shell scripts MUST stay LF or macOS/Linux can't run them.
*.sh text eol=lf
# Windows batch files want CRLF.
*.bat text eol=crlf
# Binary media: never touch.
*.wav binary
*.flac binary
*.mp4 binary
*.mov binary
*.zip binary
*.ico binary
*.icns binary
